#!/bin/bash -e

# When starting the web server, prepare the database and load the demo data.
# The seed is idempotent, so a persistent disk keeps its edits while an
# ephemeral one (Render free tier) is re-seeded on every cold start.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
